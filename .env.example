# Copy this file to .env for local development. Never commit .env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Optional shared gate for a public deployment.
APP_ACCESS_CODE=

# Retrieval and ingestion defaults
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MAX_FILE_SIZE_MB=10
MAX_FILES=10
MAX_CHUNKS=6000
TEMPERATURE=0
ALLOW_EXTRACTIVE_FALLBACK=true
